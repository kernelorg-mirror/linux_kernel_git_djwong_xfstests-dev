# FS QA Test No. 1960
#
# Regression test for a reflink bug where a program can trick XFS into
# removing the delalloc reservation in the cow fork for a shared block that
# covers EOF when two threads are racing to write or resize the file.  This
# enables attackers to rewrite a shared block.
. ./common/preamble
_begin_fstest auto quick clone

. ./common/filter
. ./common/reflink

_require_test_program "iomap-dirty-delalloc"
_require_user fsgqa
_require_group fsgqa
_require_scratch_reflink
_require_cp_reflink

_fixed_by_fs_commit xfs XXXXXXXXXXXXXX \
	"iomap: don't punch delalloc under a dirty EOF block"

_scratch_mkfs >> $seqres.full
_scratch_mount

victim=$SCRATCH_MNT/srcfile
userdir=$SCRATCH_MNT/user1
blksz=$(_get_file_block_size $SCRATCH_MNT)
test "$blksz" = 4096 || _notrun "test requires 4k fsblock size"

filesz=$((blksz + 50))
mkdir -p $userdir
$XFS_IO_PROG -f -c "pwrite -S 0x59 0 $filesz" $victim >> $seqres.full
$XFS_IO_PROG -f -c "pwrite -S 0x59 0 $filesz" $victim.copy >> $seqres.full
sync

chown $qa_user:$qa_group $userdir
chmod +r $victim

_su $qa_user -c "./src/iomap-dirty-delalloc $userdir $victim $((200 * TIME_FACTOR))" &> $tmp.out

echo "Errors from reproducer:" >> $seqres.full
cat $tmp.out >> $seqres.full
grep -v -E '(unchanged|one mprotect)' $tmp.out

_scratch_cycle_mount

cmp -s $victim $victim.copy || \
	echo "File data corrupted, kaboom!"

_exit 0
