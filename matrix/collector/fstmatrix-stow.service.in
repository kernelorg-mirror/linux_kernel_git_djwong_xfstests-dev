[Unit]
Description=Stow fstests Tarballs in Matrix

[Service]
Type=oneshot
User=%fstmatrix_user%
Group=%fstmatrix_user%
PrivateTmp=yes
Environment=HOME=%fstmatrix_home_dir%/
ExecStart=%pkg_libexec_dir%/stow_tarballs %fstmatrix_inst_dir%/database %fstmatrix_inst_dir%/tarballs
Nice=19
