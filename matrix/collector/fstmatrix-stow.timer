[Unit]
Description=Periodically Stow fstests Tarballs in Matrix

[Timer]
# Every 17 minutes, since the VMs report every 13 minutes
OnCalendar=*-*-* *:01/17:00
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
