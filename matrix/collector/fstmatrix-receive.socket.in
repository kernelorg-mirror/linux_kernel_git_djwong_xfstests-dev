[Unit]
Description=Socket for Receive fstests Results Tarball

[Socket]
ListenStream=%fstmatrix_home_dir%/tarballs.sock
Accept=no
SocketMode=0220
SocketGroup=www-data
SocketUser=www-data
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
